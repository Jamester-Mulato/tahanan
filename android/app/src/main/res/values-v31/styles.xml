<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: background colour + the Tahanan mark. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/tahanan_splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/tahanan_splash_bg</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@color/tahanan_splash_bg</item>
        <item name="android:navigationBarColor">@color/tahanan_splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
