<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tahanan always uses the light white-green theme, so the night-mode
         launch screen mirrors the light one instead of flashing black. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@color/tahanan_splash_bg</item>
        <item name="android:navigationBarColor">@color/tahanan_splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/tahanan_splash_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
