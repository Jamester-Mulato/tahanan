# ============================================================
# Tahanan backend environment
# Copy to .env for local development. Every value below is read
# at boot by src/config/env.ts (zod-validated).
# ============================================================

# ---- Runtime ------------------------------------------------
NODE_ENV=development
PORT=8080

# ---- Database: local Postgres -------------------------------
# Ignored whenever DATABASE_URL is set.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=tahanan
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_POSTGRES_PASSWORD
DATABASE_ADMIN_DATABASE=postgres

# ---- Database: managed Postgres (Neon / Render / Supabase) ---
# Paste the provider's connection string (use the pooled "-pooler" host on
# Neon). Example:
# postgresql://tahanan:secret@ep-cool-name-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Leave empty to use TLS automatically whenever DATABASE_URL is set.
# Set to false only if your provider really serves plaintext Postgres.
DATABASE_SSL=

# Managed providers create the database for you; the app role cannot run
# CREATE DATABASE. Keep DB_AUTO_CREATE=false there. Locally it can stay true.
DB_AUTO_CREATE=true
DB_AUTO_INIT_SCHEMA=true
DB_VERIFY_SCHEMA=true

# ---- Identity ------------------------------------------------
# Comma-separated Google OAuth client IDs (Android + web if both used)
GOOGLE_CLIENT_IDS=YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=CHANGE_ME_TO_32_RANDOM_BYTES_BASE64

# ---- Session / lockout policy (handout) ----------------------
IDLE_TIMEOUT_SECONDS=360
LOCKOUT_TIER1_SECONDS=16
LOCKOUT_TIER2_SECONDS=32
LOCKOUT_TIER3_SECONDS=64
IP_BLOCK_THRESHOLD=13
IP_BLOCK_SECONDS=600

# ---- Web origin / links -------------------------------------
# Comma-separated browser origins allowed to call the API.
# Add the deployed web app origin, e.g. https://tahanan.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:8080,http://127.0.0.1:8080
# Used in security-alert emails ("reset your password" link).
APP_PUBLIC_URL=http://localhost:5173

# ---- Google reCAPTCHA v2 -------------------------------------
# Create keys at https://www.google.com/recaptcha/admin and add every host
# that serves the widget (localhost, your Render web domain).
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_SECRET_KEY

# ---- Outgoing mail (login OTP / alerts) ----------------------
# Without these the OTP is only written to the server log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASS=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM=Tahanan Secure <YOUR_GMAIL_ADDRESS>
